# SiteCommand Environment Variables
# Copy this to .env and fill in your values

# ─── WhatsApp Business API (Meta Cloud API) ───
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_for_webhook
WHATSAPP_APP_SECRET=your_app_secret_for_signature_verification

# ─── Server ───
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# ─── AI Services ───
OPENAI_API_KEY=your_openai_api_key

# ─── Dashboard Auth (simple token for demo) ───
DASHBOARD_SECRET=change_this_to_a_strong_secret

# ─── File Storage ───
UPLOAD_DIR=./uploads
